# Algorand node (use public testnet node for dev; replace for mainnet)
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud

# "mainnet" or "testnet"
ALGORAND_NETWORK=testnet

# Captre's service/deployer account — this account submits all on-chain app calls
# Generate with: algokit generate account  OR  goal account new
DEPLOYER_MNEMONIC=
SERVICE_MNEMONIC=


# The Algorand address that receives x402 payments (must match SERVICE_MNEMONIC account)
RECEIVER_ADDRESS=

# Set after first deploy (deploy.py writes this automatically)
APP_ID=
APP_ADDRESS=

# TaskApp — set after uv run captre-deploy-task (fund TASK_APP_ADDRESS with ≥2 ALGO first)
TASK_APP_ID=
TASK_APP_ADDRESS=

# LedgerApp — set after uv run captre-deploy-ledger (fund LEDGER_APP_ADDRESS with ≥2 ALGO first)
LEDGER_APP_ID=
LEDGER_APP_ADDRESS=

# GoPlausible facilitator (required — do not change for competition)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Pricing (USD amounts as strings)
ATTEST_PRICE=$0.05
REVOKE_PRICE=$0.05
SUBMIT_TASK_PRICE=$0.01
EVALUATE_PRICE=$0.01

# SQLite index path (optional — default: <project_root>/data/index.db)
# On Render: add a Persistent Disk mounted at /data, then set:
# INDEX_DB_PATH=/data/index.db
INDEX_DB_PATH=
