    "contract": {
        "name": "TaskApp",
        "desc": "\n    On-chain task submission registry.\n\n    Stores first-claim task records keyed by a SHA-256 digest of the task\n    content string. Supports update and deletion so stranded ALGO can always\n    be recovered.\n\n    Attributes\n    ----------\n    tasks : BoxMap[Bytes, Bytes]\n        Maps ``task_hash_key`` (32-byte SHA-256 digest of the task content\n        string) \u2192 serialised JSON metadata blob.\n        Box key prefix: ``b\"t:\"``. Box name is always 34 bytes.\n    ",
        "methods": [
            {
                "name": "submit_task",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "task_hash_key",
                        "desc": "32-byte SHA-256 digest of the task content string. Used as the ``tasks`` box key. Must not already exist \u2014 aborts with ``ERR_ALREADY_CLAIMED`` if so."
                    },
                    {
                        "type": "byte[]",
                        "name": "task_hash_str",
                        "desc": "The original task content hash string (UTF-8 encoded). Stored verbatim inside ``metadata_json``; included here for parity with the ``CaptreApp`` ``attest()`` signature."
                    },
                    {
                        "type": "byte[]",
                        "name": "task_id",
                        "desc": "Server-generated UUID for this task record (UTF-8 encoded)."
                    },
                    {
                        "type": "string",
                        "name": "author",
                        "desc": "Algorand address of the payer. Stored inside ``metadata_json``; validated non-empty here."
                    },
                    {
                        "type": "byte[]",
                        "name": "metadata_json",
                        "desc": "Full JSON-serialised ``TaskRecord``. Written verbatim to the ``tasks`` box."
                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Write a new task record. Fails if ``task_hash_key`` is already claimed."
            },
            {
                "name": "get_task",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "task_hash_key",
                        "desc": "The 32-byte SHA-256 digest key to look up."
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "byte[]",
                    "desc": "The raw JSON metadata blob stored in the box, or ``b\"\"`` if no box exists for this key."
                },
                "desc": "Read a task record by ``task_hash_key``."
            },
            {
                "name": "task_exists",
                "args": [
                    {
                        "type": "byte[]",
                        "name": "task_hash_key",
                        "desc": "The 32-byte SHA-256 digest key to check."
                    }
                ],
                "readonly": true,
                "returns": {
                    "type": "bool",
                    "desc": "``True`` if a box exists for this key, ``False`` otherwise."
                },
                "desc": "Check whether a ``task_hash_key`` has already been submitted."
            }
        ],
        "networks": {}
    },
    "bare_call_config": {
        "update_application": "CALL",
        "delete_application": "CALL",
        "no_op": "CREATE"
    }
}