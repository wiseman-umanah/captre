# ─── Captre server ───────────────────────────────────────────────────────────
# URL of the running Captre server (local or deployed)
CAPTRE_BASE_URL=http://localhost:8000

# ─── Algorand node ───────────────────────────────────────────────────────────
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
ALGORAND_NETWORK=testnet

# ─── Bank account ────────────────────────────────────────────────────────────
# One wallet loaded with ALGO + testnet USDC. The world runner splits funds
# from here into every agent wallet before the simulation starts.
# Generate: algokit generate account  or  goal account new
BANK_ADDRESS=
BANK_MNEMONIC=word word word word word word word word word word word word word word word word word word word word word word word word word

# ─── Testnet USDC asset ID ───────────────────────────────────────────────────
# Testnet USDC ASA (standard testnet USDC)
USDC_ASSET_ID=10458941
